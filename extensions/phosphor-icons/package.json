{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "phosphor-icons",
  "title": "Phosphor Icons",
  "description": "Search, preview and copy Phosphor Icons",
  "icon": "command-icon.png",
  "author": "marinsokol",
  "contributors": [
    "YourMCGeek"
  ],
  "categories": [
    "Design Tools",
    "Developer Tools",
    "Documentation",
    "Web"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "search",
      "title": "Search Phosphor Icons",
      "description": "Search, preview and copy Phosphor Icons",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "view",
      "title": "View",
      "description": "The view to display the icons in.",
      "type": "dropdown",
      "default": "grid",
      "required": false,
      "data": [
        {
          "title": "Grid",
          "value": "grid"
        },
        {
          "title": "List",
          "value": "list"
        }
      ]
    }
  ],
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.2",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/lodash": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
